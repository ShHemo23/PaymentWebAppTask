## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015 cache/options directory
.vs/
# Visual Studio 2017 cache/options directory
.vs.sln.closed
# Omit SLN files from command line builds to prevent version-control churn.
*.sln.metaproj

# Visual Studio 2019 cache
.vs-dev-console.log

# Rider files
.idea/
*.sln.iml

# Code Analysis
*.sarif
*.codeanalysis.sarif.json

# Test results
*.trx
*.html
*.coverage
*.coverage.cobertura.xml

# Misc
*.dll
*.exe
*.pdb
*.nupkg
*.snupkg
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.rar
*.db
*.sqlite
*.sqlite3
TestResult/
coverage/

# mstest
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.nunit
nunit-agent*.log
nunit-console*.log

# Windows thumbnail cache files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db

# Dump files
*.mdmp
*.dmp

# Node.js
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# VS Code
.vscode/ 